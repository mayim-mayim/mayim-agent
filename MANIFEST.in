# Distribution content excludes private implementation and operator material.
exclude AGENTS.md DEVELOPMENT.md
prune .agents
prune docs/evidence
prune tests/evidence
prune scripts/release
global-exclude __pycache__ *.py[cod]

recursive-include mayim_agent/contracts/v189-endpoint-choice-reason *
recursive-include mayim_agent/contracts/v183-immediate-visit-v2 *

recursive-include tests/fixtures/v189 *.mjs

recursive-include mayim_agent/contracts/v185-paid-service-trial-v3 *
