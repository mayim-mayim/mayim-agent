include README.md
include CHANGELOG.md
include server.json
recursive-include mayim_agent/contracts/mag-activity-map *
recursive-include mayim_agent/contracts/mag-task-packs *
recursive-include tests/fixtures/mag *.mjs
recursive-include tests/fixtures/mag *.py
recursive-include tests/fixtures/v1816-c4 *
recursive-include docs *.md
recursive-include examples *.py
recursive-include tests *.py
recursive-include tests/fixtures/v183-immediate-visit *.json
recursive-include mayim_agent/contracts/v183-immediate-visit *
recursive-include mayim_agent/contracts/v185-paid-service-trial *
include mayim_agent/_vendor/justhtml/LICENSE
include mayim_agent/_vendor/justhtml/UPSTREAM.md
include mayim_agent/_vendor/justhtml/compatibility.patch
include mayim_agent/_vendor/justhtml/py.typed
recursive-include mayim_agent/contracts/v185-paid-service-trial-v2 *
