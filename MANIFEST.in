recursive-include mayim_agent/contracts/v1814-structured-response-v3 *
recursive-include mayim_agent/contracts/v1814-endpoint-choice-reason-v2_1 *

# DC-fixed c4 economic packs and immutable external correction.
recursive-include mayim_agent/contracts/v1816-scheduled-v1_1 *
