{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kari.mayim-mayim.com/agent-api-schemas/task-discovery-page.v1.schema.json",
  "$comment": "Implementation artifact of audited specification 87a1027f; that specification remains the sole semantic oracle. Page <=160 KiB UTF-8. Empty range is not an all-inventory snapshot.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "selection",
    "coverage",
    "checked_at",
    "page_scope",
    "tasks",
    "next_cursor",
    "empty_reason",
    "claim_authority"
  ],
  "properties": {
    "schema_version": {
      "const": "ln_church.task_discovery_page.v1"
    },
    "selection": {
      "const": "recruiting_candidates"
    },
    "coverage": {
      "const": "all_supported_families"
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "page_scope": {
      "enum": [
        "initial",
        "continuation"
      ]
    },
    "tasks": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^td1\\.[A-Za-z0-9_-]+$",
      "maxLength": 1024
    },
    "empty_reason": {
      "enum": [
        "no_candidates_observed_in_range",
        null
      ]
    },
    "claim_authority": {
      "const": "task_claim_endpoint"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "tasks": {
            "maxItems": 0
          }
        }
      },
      "then": {
        "properties": {
          "empty_reason": {
            "const": "no_candidates_observed_in_range"
          }
        }
      },
      "else": {
        "properties": {
          "empty_reason": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "task_type",
        "task_schema_version",
        "task_definition_version",
        "task_definition_digest",
        "title",
        "summary",
        "recruitment_state",
        "capacity_available",
        "claim_before",
        "scheduled_at",
        "eligibility",
        "detail_url",
        "definition_url",
        "projection_updated_at"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._~-]{1,128}$"
        },
        "task_type": {
          "type": "string"
        },
        "task_schema_version": {
          "type": "string"
        },
        "task_definition_version": {
          "type": "string"
        },
        "task_definition_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "title": {
          "type": "string",
          "maxLength": 256
        },
        "summary": {
          "type": "string",
          "maxLength": 256
        },
        "recruitment_state": {
          "const": "candidate"
        },
        "capacity_available": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "claim_before": {
          "type": "string",
          "format": "date-time"
        },
        "scheduled_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "eligibility": {
          "const": "check_task_details"
        },
        "detail_url": {
          "type": "string",
          "format": "uri"
        },
        "definition_url": {
          "type": "string",
          "format": "uri"
        },
        "projection_updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
