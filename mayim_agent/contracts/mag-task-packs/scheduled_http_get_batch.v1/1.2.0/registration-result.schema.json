{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "registration_intent_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._~-]{1,128}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._~-]{1,128}$"
    },
    "task_type": {
      "const": "scheduled_http_get_batch.v1"
    },
    "status": {
      "const": "OPEN"
    },
    "scheduled_at": {
      "type": "string",
      "format": "date-time"
    },
    "report_close_at": {
      "type": "string",
      "format": "date-time"
    },
    "plan_id": {
      "type": "string"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "network": {
          "const": "eip155:8453"
        },
        "asset": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "amount_atomic": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "transaction": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "confirmation_state": {
          "enum": [
            "L2_RECEIPT_CONFIRMED",
            "SAFE_CONFIRMED"
          ]
        }
      },
      "required": [
        "network",
        "asset",
        "amount_atomic",
        "transaction",
        "confirmation_state"
      ]
    }
  },
  "required": [
    "registration_intent_id",
    "task_id",
    "task_type",
    "status",
    "scheduled_at",
    "report_close_at",
    "plan_id",
    "manifest_sha256",
    "receipt"
  ]
}
