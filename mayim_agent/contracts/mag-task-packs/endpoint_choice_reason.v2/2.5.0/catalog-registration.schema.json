{
  "template": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "question",
      "options",
      "question_subject",
      "consent_version",
      "title",
      "economic_terms",
      "activity_map_policy_id",
      "activity_map_epoch",
      "answer_review_policy_id"
    ],
    "properties": {
      "schema_version": {
        "const": "ln_church.survey_template_registration_request.v6"
      },
      "question": {
        "type": "string",
        "minLength": 1
      },
      "options": {
        "type": "array",
        "minItems": 1,
        "maxItems": 10,
        "items": {
          "type": "string"
        }
      },
      "question_subject": {
        "enum": [
          "Agent",
          "Human",
          "Both"
        ]
      },
      "consent_version": {
        "const": "survey-template-bundle-terms-v1"
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120,
        "description": "Normalize Unicode White_Space to ASCII space and trim; reject invalid Unicode and remaining C0/C1 controls. Require 1–120 Unicode scalars after normalization, without truncation or NFC/NFKC. Confirm this plain-text value before payment."
      },
      "economic_terms": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "economic_terms_revision",
          "plan_id",
          "registration_amount_atomic",
          "capacity_total",
          "reward",
          "creator_amount_atomic"
        ],
        "properties": {
          "economic_terms_revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._~-]+$"
          },
          "plan_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._~-]+$"
          },
          "registration_amount_atomic": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$",
            "maxLength": 78,
            "description": "Canonical uint256 decimal atomic units; validate <= 2^256-1 with integer arithmetic."
          },
          "capacity_total": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "reward": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "network",
              "asset",
              "asset_address",
              "correct_amount_atomic",
              "incorrect_amount_atomic"
            ],
            "properties": {
              "network": {
                "const": "eip155:8453"
              },
              "asset": {
                "const": "USDC"
              },
              "asset_address": {
                "type": "string",
                "enum": [
                  "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913",
                  "0x833589fcd6edb6e08f4c7c32d4f71b54bda02913"
                ]
              },
              "correct_amount_atomic": {
                "type": "string",
                "pattern": "^[1-9][0-9]*$",
                "maxLength": 78,
                "description": "Canonical uint256 decimal atomic units; validate <= 2^256-1 with integer arithmetic."
              },
              "incorrect_amount_atomic": {
                "type": "string",
                "pattern": "^[1-9][0-9]*$",
                "maxLength": 78,
                "description": "Canonical uint256 decimal atomic units; validate <= 2^256-1 with integer arithmetic."
              }
            }
          },
          "creator_amount_atomic": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "maxLength": 78,
            "description": "Canonical uint256 decimal atomic units; validate <= 2^256-1 with integer arithmetic."
          }
        }
      },
      "activity_map_policy_id": {
        "const": "mag.activity-map.public.v1"
      },
      "activity_map_epoch": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._~-]{1,128}$"
      },
      "answer_review_policy_id": {
        "const": "mag.answer-reuse-review.public.v1"
      }
    }
  },
  "task": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "template_id",
      "revision",
      "content_digest",
      "plan_amount_atomic",
      "supplement",
      "consent_version",
      "conditions_ref",
      "economic_terms",
      "activity_map_policy_id",
      "activity_map_epoch",
      "answer_review_policy_id"
    ],
    "properties": {
      "schema_version": {
        "const": "ln_church.survey_template_task_registration_request.v5"
      },
      "template_id": {
        "type": "string",
        "pattern": "^tpl_[a-f0-9]{32}$"
      },
      "revision": {
        "const": 1
      },
      "content_digest": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "plan_amount_atomic": {
        "type": "string",
        "pattern": "^[1-9][0-9]*$",
        "maxLength": 78,
        "description": "Canonical uint256 decimal atomic units; validate <= 2^256-1 with integer arithmetic."
      },
      "supplement": {
        "type": "string"
      },
      "consent_version": {
        "const": "survey-template-task-terms-v1"
      },
      "conditions_ref": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "economic_terms": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "economic_terms_revision",
          "plan_id",
          "registration_amount_atomic",
          "capacity_total",
          "reward",
          "creator_amount_atomic"
        ],
        "properties": {
          "economic_terms_revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._~-]+$"
          },
          "plan_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._~-]+$"
          },
          "registration_amount_atomic": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$",
            "maxLength": 78,
            "description": "Canonical uint256 decimal atomic units; validate <= 2^256-1 with integer arithmetic."
          },
          "capacity_total": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "reward": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "network",
              "asset",
              "asset_address",
              "correct_amount_atomic",
              "incorrect_amount_atomic"
            ],
            "properties": {
              "network": {
                "const": "eip155:8453"
              },
              "asset": {
                "const": "USDC"
              },
              "asset_address": {
                "type": "string",
                "enum": [
                  "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913",
                  "0x833589fcd6edb6e08f4c7c32d4f71b54bda02913"
                ]
              },
              "correct_amount_atomic": {
                "type": "string",
                "pattern": "^[1-9][0-9]*$",
                "maxLength": 78,
                "description": "Canonical uint256 decimal atomic units; validate <= 2^256-1 with integer arithmetic."
              },
              "incorrect_amount_atomic": {
                "type": "string",
                "pattern": "^[1-9][0-9]*$",
                "maxLength": 78,
                "description": "Canonical uint256 decimal atomic units; validate <= 2^256-1 with integer arithmetic."
              }
            }
          },
          "creator_amount_atomic": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "maxLength": 78,
            "description": "Canonical uint256 decimal atomic units; validate <= 2^256-1 with integer arithmetic."
          }
        }
      },
      "activity_map_policy_id": {
        "const": "mag.activity-map.public.v1"
      },
      "activity_map_epoch": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._~-]{1,128}$"
      },
      "answer_review_policy_id": {
        "const": "mag.answer-reuse-review.public.v1"
      }
    }
  }
}
