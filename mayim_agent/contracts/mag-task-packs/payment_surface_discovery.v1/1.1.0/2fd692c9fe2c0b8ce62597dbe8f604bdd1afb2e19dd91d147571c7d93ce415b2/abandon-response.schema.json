{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "ln_church.agent_task_claim_abandon_response.v1"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._~-]{1,128}$"
    },
    "execution_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._~-]{1,128}$"
    },
    "state": {
      "const": "ABANDONED"
    },
    "abandonment_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._~-]{1,128}$"
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "execution_id",
    "state",
    "abandonment_id"
  ]
}
