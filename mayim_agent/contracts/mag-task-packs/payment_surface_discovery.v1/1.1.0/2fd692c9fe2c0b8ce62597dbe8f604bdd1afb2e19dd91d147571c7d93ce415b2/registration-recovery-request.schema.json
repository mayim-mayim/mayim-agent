{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "challenge_token",
    "typed_data",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": "ln_church.registration_read_request.v1"
    },
    "challenge_token": {
      "type": "string"
    },
    "typed_data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "primaryType",
        "types",
        "message"
      ],
      "properties": {
        "domain": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version",
            "chainId"
          ],
          "properties": {
            "name": {
              "const": "LNChurch Registration Recovery"
            },
            "version": {
              "const": "1"
            },
            "chainId": {
              "const": 8453
            }
          }
        },
        "primaryType": {
          "const": "OfferRegistrationRead"
        },
        "types": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "EIP712Domain",
            "OfferRegistrationRead"
          ],
          "properties": {
            "EIP712Domain": {
              "const": [
                {
                  "name": "name",
                  "type": "string"
                },
                {
                  "name": "version",
                  "type": "string"
                },
                {
                  "name": "chainId",
                  "type": "uint256"
                }
              ]
            },
            "OfferRegistrationRead": {
              "const": [
                {
                  "name": "audience",
                  "type": "string"
                },
                {
                  "name": "action",
                  "type": "string"
                },
                {
                  "name": "profile",
                  "type": "string"
                },
                {
                  "name": "operationRef",
                  "type": "string"
                },
                {
                  "name": "payer",
                  "type": "address"
                },
                {
                  "name": "nonce",
                  "type": "bytes32"
                },
                {
                  "name": "issuedAt",
                  "type": "uint256"
                },
                {
                  "name": "expiresAt",
                  "type": "uint256"
                }
              ]
            }
          }
        },
        "message": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "audience",
            "action",
            "profile",
            "operationRef",
            "payer",
            "nonce",
            "issuedAt",
            "expiresAt"
          ],
          "properties": {
            "audience": {
              "const": "https://kari.mayim-mayim.com/api/agent/task-offer-registration-recovery/status"
            },
            "action": {
              "const": "read_registration_result"
            },
            "profile": {
              "const": "V17_STRICT_TASK_OFFER"
            },
            "operationRef": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "payer": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{40}$"
            },
            "nonce": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{64}$"
            },
            "issuedAt": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "expiresAt": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            }
          }
        }
      }
    },
    "signature": {
      "type": "string",
      "pattern": "^0x(?:[0-9a-fA-F]{2})+$"
    }
  }
}
