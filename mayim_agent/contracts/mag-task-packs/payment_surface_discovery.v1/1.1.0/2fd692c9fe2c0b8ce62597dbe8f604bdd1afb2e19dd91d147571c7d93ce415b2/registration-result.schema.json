{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "ln_church.task_offer_create_response.v1"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._~-]{1,128}$"
    },
    "task_type": {
      "const": "payment_surface_discovery.v1"
    },
    "status": {
      "const": "OPEN"
    },
    "task_url": {
      "type": "string",
      "pattern": "^/api/agent/tasks/[A-Za-z0-9._~-]{1,128}$"
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "task_type",
    "status",
    "task_url"
  ]
}
